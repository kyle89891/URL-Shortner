# Copy this file to .env and fill in real values.

# MySQL connection string used by SQLAlchemy.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/urlshortener

# Redis connection string.
REDIS_URL=redis://localhost:6379/0

# Used when building the full short URL to return to clients, e.g. http://localhost:8000
BASE_HOST=http://localhost:8000

# How long a redirect stays cached in Redis (seconds).
CACHE_TTL_SECONDS=3600

# Fixed-window rate limiter settings.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# How often the background task flushes buffered Redis click counts into MySQL (seconds).
CLICK_FLUSH_INTERVAL_SECONDS=10
